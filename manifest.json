{
  "manifest_version": 3,
  "name": "Upstox Tab Switcher Alerts",
  "version": "1.5.0",
  "description": "Reads displayed option-chain OI, volume and premiums to generate filtered directional alerts.",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": ["activeTab", "alarms", "notifications", "offscreen", "scripting", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": [
    "<all_urls>",
    "https://pro.upstox.com/*",
    "https://discord.com/api/webhooks/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pro.upstox.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icon-128.png",
    "default_popup": "popup.html",
    "default_title": "Upstox Alerts"
  }
}
